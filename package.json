{
  "name": "lingutribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Local-first language-learning app — offline STT (Moonshine/sherpa-onnx), TTS (Kokoro), MDict dictionary and an optional LLM tutor. Unified engine + React UI + Electron desktop shell in one repo.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.mjs --packages=external --external:better-sqlite3 --external:onnxruntime-node --external:onnxruntime-common --external:fsevents --log-level=warning",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "app": "electron .",
    "dist:mac": "vite build && npm run build:server && electron-builder --mac"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@divisey/js-mdict": "^5.0.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "https-proxy-agent": "^9.1.0",
    "jsdom": "^26.0.0",
    "kokoro-js": "^1.2.1",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-node": "^1.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sherpa-onnx-node": "^1.13.5",
    "undici": "^6.28.0",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.2.2"
  },
  "build": {
    "appId": "com.lingutribe.app",
    "productName": "Lingutribe",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "dist-server/**",
      "node_modules/**",
      "package.json",
      {
        "from": "data",
        "to": "data",
        "filter": ["coca-bands.json"]
      }
    ],
    "asar": false,
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    }
  }
}
