# ── Dependencies ──────────────────────────────
node_modules/

# ── Python virtual env (only used by data/coca-build/extract.py) ──
.venv/

# ── Build output ───────────────────────────────
dist/
dist-server/
dist-electron/
build/

# ── Runtime / generated library data (models ~564MB + COCA PDFs) ──
# Not source code; regenerated / downloaded at runtime.
# EXCEPTION: coca-bands.json (266KB) is committed so the repo works out of
# the box — the app needs it for word-band highlighting and it has no
# runtime auto-regeneration.
data/*
!data/coca-bands.json

# ── macOS junk ─────────────────────────────────
.DS_Store

# ── Logs ───────────────────────────────────────
*.log

# ── Local-only dev docs (not for the public repo) ──
DEV-SUMMARY.md

# ── Local WorkBuddy memory / dev logs (not source, never push) ──
.workbuddy/

# ── Local backups (never push) ─────────────────
src.bak-*/
build-backup.*
